{
  "name": "posed-camera",
  "icon": "resources/viewer_logo.png",
  "displayName": "Posed Camera",
  "description": "VS Code extension for viewing PLY point cloud data in a webview.",
  "version": "0.0.5",
  "publisher": "local",
  "author": "Dirk Raproeger",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:posedCamera.plyViewer",
    "onCommand:posed-camera.openWebview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "posed-camera.openWebview",
        "title": "Open Posed Camera PLY Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "posedCamera.plyViewer",
        "displayName": "Posed Camera PLY Viewer",
        "selector": [
          {
            "filenamePattern": "*.ply"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "ply",
        "aliases": [
          "PLY"
        ],
        "extensions": [
          ".ply"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p ./src/webview/tsconfig.json",
    "watch": "tsc -watch -p ./",
    "watch:webview": "tsc -watch -p ./src/webview/tsconfig.json",
    "watch:all": "concurrently \"npm run watch\" \"npm run watch:webview\"",
    "lint": "echo \"No lint configured\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@types/vscode": "^1.90.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
